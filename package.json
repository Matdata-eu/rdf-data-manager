{
  "name": "rdf-data-manager-monorepo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "CRUD web application for RDF data behind a SPARQL endpoint, driven by SHACL/DASH shapes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Matdata-eu/rdf-data-manager.git"
  },
  "workspaces": [
    "packages/core",
    "packages/react",
    "packages/widget-map",
    "packages/widget-time",
    "packages/app",
    "packages/shapes-dim"
  ],
  "scripts": {
    "dev": "npm run dev -w packages/app",
    "build": "npm run build -w packages/core -w packages/react -w packages/widget-map -w packages/widget-time -w packages/app",
    "preview": "npm run preview -w packages/app",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -b",
    "validate-endpoint": "npm run validate-endpoint -w packages/shapes-dim --",
    "load-shapes": "npm run load-shapes -w packages/shapes-dim --",
    "prepare": "simple-git-hooks"
  },
  "engines": {
    "node": ">=20"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,js}": "eslint --fix"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@rdfjs/types": "^2.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/n3": "^1.26.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "neostandard": "^0.14.1",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
