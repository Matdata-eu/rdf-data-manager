{
  "name": "rdf-data-manager",
  "version": "0.1.0",
  "description": "CRUD web application for RDF data behind a SPARQL endpoint, driven by SHACL/DASH shapes",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "rdf",
    "sparql",
    "shacl",
    "dash",
    "linked-data",
    "forms",
    "crud"
  ],
  "homepage": "https://github.com/Matdata-eu/rdf-data-manager#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Matdata-eu/rdf-data-manager.git"
  },
  "bugs": {
    "url": "https://github.com/Matdata-eu/rdf-data-manager/issues"
  },
  "bin": {
    "rdf-data-manager": "bin/rdf-data-manager.js"
  },
  "files": [
    "dist",
    "bin",
    "shapes",
    "examples",
    "docs/CONFIG.md",
    "public/config.schema.json"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "simple-git-hooks",
    "typecheck": "tsc -b",
    "validate-endpoint": "tsx tools/validate-endpoint.ts",
    "load-shapes": "tsx tools/load-shapes.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,js}": "eslint --fix"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@rdfjs/data-model": "^2.1.2",
    "@rdfjs/dataset": "^2.0.3",
    "n3": "^2.13.12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shacl-engine": "^1.1.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/n3": "^1.26.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "neostandard": "^0.14.1",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
