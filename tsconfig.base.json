{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@rdf-data-manager/core": [
        "./packages/core/src/index.ts"
      ],
      "@rdf-data-manager/react": [
        "./packages/react/src/index.ts"
      ],
      "@rdf-data-manager/widget-map": [
        "./packages/widget-map/src/index.tsx"
      ],
      "@rdf-data-manager/widget-time": [
        "./packages/widget-time/src/index.tsx"
      ]
    }
  }
}
