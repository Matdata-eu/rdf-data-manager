# ---------------------------------------------------------------------------
# Lines, with nested sections that have their own IRIs
# ---------------------------------------------------------------------------

line:l1 a ex:Line ;
    rdfs:label "Spikkestad–Lillestrøm"@en, "Spikkestad–Lillestrøm"@nb, "Spikkestad–Lillestrøm"@nn ;
    rdfs:comment "Local trains through the Oslo tunnel."@en, "Lokaltog gjennom Oslotunnelen."@nb ;
    ex:number "L1" ;
    ex:operator org:vy ;
    ex:electrified true ;
    ex:gauge 1435 ;
    ex:lengthKm 62.5 ;
    ex:serves st:asker, st:sandvika, st:lysaker, st:skoyen, st:nationaltheatret, st:oslo-s, st:lillestrom ;
    ex:section sec:l1-01, sec:l1-02, sec:l1-03 ;
    geo:hasGeometry [ a geo:Geometry ; geo:asWKT "LINESTRING (10.4348 59.8333, 10.5243 59.8913, 10.6375 59.9128, 10.6789 59.9222, 10.7315 59.9145, 10.7522 59.9108, 11.0490 59.9534)"^^geo:wktLiteral ] ;
    dcterms:created "2026-01-05"^^xsd:date .

sec:l1-01 a ex:Section ; ex:sectionCode "l1-01" ; ex:position 1 ; ex:from st:asker ; ex:to st:lysaker ; ex:maxSpeed 130 .
sec:l1-02 a ex:Section ; ex:sectionCode "l1-02" ; ex:position 2 ; ex:from st:lysaker ; ex:to st:oslo-s ; ex:maxSpeed 80 .
sec:l1-03 a ex:Section ; ex:sectionCode "l1-03" ; ex:position 3 ; ex:from st:oslo-s ; ex:to st:lillestrom ; ex:maxSpeed 210 .

line:f4 a ex:Line ;
    rdfs:label "Bergen Line"@en, "Bergensbanen"@nb, "Bergensbanen"@nn ;
    rdfs:comment "Long-distance trains across Hardangervidda."@en, "Fjerntog over Hardangervidda."@nb ;
    ex:number "F4" ;
    ex:operator org:sj-norge ;
    ex:electrified true ;
    ex:gauge 1435 ;
    ex:lengthKm 496.0 ;
    ex:serves st:oslo-s, st:drammen, st:brakeroya, st:honefoss, st:finse, st:myrdal, st:voss, st:bergen ;
    ex:section sec:f4-01, sec:f4-02 ;
    geo:hasGeometry [ a geo:Geometry ; geo:asWKT "LINESTRING (10.7522 59.9108, 10.2045 59.7404, 10.2580 60.1680, 7.5032 60.6014, 7.1213 60.7350, 6.4170 60.6290, 5.3328 60.3903)"^^geo:wktLiteral ] .

sec:f4-01 a ex:Section ; ex:sectionCode "f4-01" ; ex:position 1 ; ex:from st:oslo-s ; ex:to st:honefoss ; ex:maxSpeed 160 .
sec:f4-02 a ex:Section ; ex:sectionCode "f4-02" ; ex:position 2 ; ex:from st:honefoss ; ex:to st:bergen ; ex:maxSpeed 130 .

line:flytoget a ex:Line ;
    rdfs:label "Airport Express"@en, "Flytoget"@nb, "Flytoget"@nn ;
    ex:number "FX1" ;
    ex:operator org:flytoget ;
