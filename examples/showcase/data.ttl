st:oslo-s a ex:Station ;
    rdfs:label "Oslo Central"@en, "Oslo sentralstasjon"@nb, "Oslo sentralstasjon"@nn ;
    rdfs:comment "The main station of Oslo and the busiest in Norway."@en,
        "Hovedstasjonen i Oslo og den travleste i Norge."@nb ;
    ex:code "OSL" ;
    ex:category ex:Hub ;
    ex:status "open" ;
    ex:opened "1980-06-01"^^xsd:date ;
    ex:homepage <https://www.banenor.no/reise-og-trafikk/stasjoner/oslo-s/> ;
    ex:platforms 19 ;
    ex:stepFree true ;
    ex:passengersPerDay 150000.0 ;
    ex:internalNote "Hidden in the form (dash:hidden), still in the data." ;
    geo:hasGeometry [ a geo:Geometry ; geo:asWKT "POINT (10.7522 59.9108)"^^geo:wktLiteral ] ;
    dcterms:created "2026-01-05"^^xsd:date ;
    dcterms:modified "2026-09-30"^^xsd:date .

