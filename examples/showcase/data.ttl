# ---------------------------------------------------------------------------
# Track closures: an OWL-Time interval and the other time datatypes
# ---------------------------------------------------------------------------

<https://example.org/showcase/closure/finse-summer-2026> a ex:Closure ;
    rdfs:label "Finse track renewal"@en, "Sporfornyelse Finse"@nb, "Spornyving Finse"@nn ;
    rdfs:comment "Night closures while the track over the mountain is renewed."@en ;
    ex:affects line:f4, st:finse ;
    ex:contact person:kari-nordmann ;
    time:hasTime [
        a time:Interval ;
        time:hasBeginning [ a time:Instant ; time:inXSDDate "2026-06-20"^^xsd:date ] ;
        time:hasEnd [ a time:Instant ; time:inXSDDate "2026-07-05"^^xsd:date ]
    ] ;
    ex:dailyStart "22:30:00"^^xsd:time ;
    ex:duration "PT6H30M"^^xsd:duration ;
    ex:budgetYear "2026"^^xsd:gYear ;
    ex:announcedIn "2026-01"^^xsd:gYearMonth ;
    ex:reported "2026-01-15"^^xsd:date ;
    dcterms:created "2026-01-15"^^xsd:date .

<https://example.org/showcase/closure/oslo-tunnel-2026> a ex:Closure ;
    rdfs:label "Oslo tunnel inspection"@en, "Inspeksjon av Oslotunnelen"@nb, "Inspeksjon av Oslotunnelen"@nn ;
    ex:affects st:oslo-s, st:nationaltheatret ;
    ex:contact person:kari-nordmann ;
    time:hasTime [
        a time:Interval ;
        time:hasBeginning [ a time:Instant ; time:inXSDDate "2026-11-07"^^xsd:date ] ;
        time:hasEnd [ a time:Instant ; time:inXSDDate "2026-11-08"^^xsd:date ]
    ] ;
    ex:dailyStart "01:00:00"^^xsd:time ;
    ex:duration "PT4H"^^xsd:duration ;
    ex:budgetYear "2026"^^xsd:gYear ;
    ex:reported "2026-02-01"^^xsd:date .

