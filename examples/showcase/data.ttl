# Operated by a person rather than an organisation (sh:xone).
line:m1 a ex:Line ;
    rdfs:label "Old Voss Line"@en, "Gamle Vossebanen"@nb, "Gamle Vossebanen"@nn ;
    rdfs:comment "A museum railway run by volunteers."@en, "En museumsbane drevet av frivillige."@nb ;
