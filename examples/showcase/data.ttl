# Data for the feature tour (shapes.ttl). Coordinates and facts are approximate.
# A few resources break the shapes on purpose so the validation report has something to
# show; README.md lists them.
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix schema:  <http://schema.org/> .
@prefix geo:     <http://www.opengis.net/ont/geosparql#> .
@prefix time:    <http://www.w3.org/2006/time#> .
@prefix ex:      <https://example.org/showcase/> .
@prefix st:      <https://example.org/showcase/station/> .
@prefix line:    <https://example.org/showcase/line/> .
@prefix sec:     <https://example.org/showcase/section/> .
@prefix org:     <https://example.org/showcase/org/> .
@prefix person:  <https://example.org/showcase/person/> .
@prefix query:   <https://example.org/showcase/query/> .

