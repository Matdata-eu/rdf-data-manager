# ---------------------------------------------------------------------------
# Stored queries and a report that runs one
# ---------------------------------------------------------------------------

query:busiest-stations a ex:Query ;
    rdfs:label "Stations by number of platforms"@en, "Stasjoner etter antall plattformer"@nb, "Stasjonar etter tal på plattformer"@nn ;
    ex:text """PREFIX ex: <https://example.org/showcase/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?station ?name ?platforms
WHERE {
  ?station a ex:Station ;
           rdfs:label ?name ;
           ex:platforms ?platforms .
  FILTER (lang(?name) = "en")
}
ORDER BY DESC(?platforms)""" .

query:stations-per-line a ex:Query ;
    rdfs:label "Stations per line"@en, "Stasjoner per linje"@nb, "Stasjonar per linje"@nn ;
    ex:text """PREFIX ex: <https://example.org/showcase/>
SELECT ?number (COUNT(?station) AS ?stations)
WHERE {
  ?line a ex:Line ;
        ex:number ?number ;
        ex:serves ?station .
}
GROUP BY ?number
ORDER BY DESC(?stations)""" .

<https://example.org/showcase/report/platforms> a ex:Report ;
    rdfs:label "Platform overview"@en, "Plattformoversikt"@nb, "Plattformoversyn"@nn ;
    rdfs:comment "Open the report and press \"Preview query result\" under the query."@en ;
    ex:usesQuery query:busiest-stations .

<https://example.org/showcase/report/line-sizes> a ex:Report ;
    rdfs:label "Line sizes"@en, "Linjestørrelser"@nb, "Linjestorleikar"@nn ;
    ex:usesQuery query:stations-per-line .
