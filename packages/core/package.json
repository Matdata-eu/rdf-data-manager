{
  "name": "@rdf-data-manager/core",
  "version": "0.1.0",
  "description": "Shape-driven form state, SPARQL diffing and SHACL validation for editing RDF data: the engine of RDF Data Manager, without any UI",
  "keywords": [
    "rdf",
    "sparql",
    "shacl",
    "dash",
    "linked-data",
    "forms"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Matdata-eu/rdf-data-manager.git"
  },
  "homepage": "https://github.com/Matdata-eu/rdf-data-manager#readme",
  "bugs": {
    "url": "https://github.com/Matdata-eu/rdf-data-manager/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@rdfjs/data-model": "^2.1.2",
    "@rdfjs/dataset": "^2.0.3",
    "n3": "^2.13.12",
    "shacl-engine": "^1.1.3"
  },
  "devDependencies": {
    "@rdfjs/types": "^2.0.1"
  }
}
