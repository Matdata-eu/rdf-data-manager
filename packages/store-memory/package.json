{
  "name": "@rdf-data-manager/store-memory",
  "version": "0.2.0",
  "description": "An in-memory SPARQL store (Oxigraph, WebAssembly) behind the RDF Data Manager client interface, for the demo mode and for tests without a server",
  "keywords": [
    "rdf",
    "sparql",
    "oxigraph",
    "wasm"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Matdata-eu/rdf-data-manager.git"
  },
  "homepage": "https://github.com/Matdata-eu/rdf-data-manager#readme",
  "bugs": {
    "url": "https://github.com/Matdata-eu/rdf-data-manager/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@rdf-data-manager/core": "1.0.0",
    "oxigraph": "^0.5.11"
  }
}
