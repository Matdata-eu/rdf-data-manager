# SHACL / DASH shapes for the DIM /metadata dataset.
#
# They describe the manually authored metadata that the dim-etl-dataset-generation
# DAGs read: CSV datasets (dcat:Dataset), key figures (bno:KeyFigure,
# bno:KeyFigureTable), their sections (bno:KeyFigureSection) and table columns
# (csvw:Column). dcat:Distribution resources are written by the pipeline and are
# therefore exposed read-only.
#
# The shapes serve two purposes:
#   1. validation (any SHACL Core + SHACL-SPARQL engine), and
#   2. form generation in RDF Data Manager (DASH editors / viewers, sh:group,
#      sh:order, dash:uriStart).
#
# Top-level menu entries are the target classes of node shapes that carry an
# rdfs:label; all node shapes targeting the same class are merged for that class.
# Nested shapes (table schema, distribution) have no target and are only reached
# through sh:node from their parent; csvw:Column is hidden with rdm:hideFromMenu.
#
# Load into: GRAPH <https://data.banenor.no/data/_shapes_metadata> in /metadata.

@prefix bnd:     <https://data.banenor.no/data/> .
@prefix bno:     <https://data.banenor.no/ontology/> .
@prefix csvw:    <http://www.w3.org/ns/csvw#> .
@prefix dash:    <http://datashapes.org/dash#> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdm:     <https://matdata.eu/ns/rdf-data-manager#> .
@prefix schema:  <http://schema.org/> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix spin:    <http://spinrdf.org/spin#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix yasgui:  <https://matdata.eu/ns/yasgui#> .

<https://data.banenor.no/data/_shapes_metadata>
    a owl:Ontology ;
    rdfs:label "DIM metadata shapes"@en, "DIM metadata-shapes"@nb ;
    rdfs:comment "SHACL/DASH shapes for datasets and key figures in the DIM /metadata dataset."@en ;
    sh:declare
        [ sh:prefix "bno" ;     sh:namespace "https://data.banenor.no/ontology/"^^xsd:anyURI ] ,
        [ sh:prefix "csvw" ;    sh:namespace "http://www.w3.org/ns/csvw#"^^xsd:anyURI ] ,
        [ sh:prefix "dcterms" ; sh:namespace "http://purl.org/dc/terms/"^^xsd:anyURI ] ,
        [ sh:prefix "schema" ;  sh:namespace "http://schema.org/"^^xsd:anyURI ] ,
        [ sh:prefix "spin" ;    sh:namespace "http://spinrdf.org/spin#"^^xsd:anyURI ] .

# ---------------------------------------------------------------------------
# Property groups (form sections)
# ---------------------------------------------------------------------------

bnd:_shapeGroup_general a sh:PropertyGroup ;
    rdfs:label "General"@en, "Generelt"@nb ;
    sh:order 1 .

bnd:_shapeGroup_query a sh:PropertyGroup ;
    rdfs:label "Query"@en, "Spørring"@nb ;
    sh:order 2 .

bnd:_shapeGroup_display a sh:PropertyGroup ;
    rdfs:label "Display"@en, "Visning"@nb ;
    sh:order 3 .

bnd:_shapeGroup_distributions a sh:PropertyGroup ;
    rdfs:label "Distributions (generated by the pipeline)"@en,
               "Distribusjoner (generert av pipelinen)"@nb ;
    sh:order 4 .

# ---------------------------------------------------------------------------
# Shared property shapes
# ---------------------------------------------------------------------------

# Language policy
# - Datasets, key figures and key figure tables: exactly one title and one
#   description in each of en, nb and nn.
# - Sections: English title required; nb and nn (or legacy "no") allowed, one
#   value per language. bnd:_shape_preferNbOverNo warns about "no".
bnd:_shape_titleEnNbNn a sh:PropertyShape ;
    sh:path dcterms:title ;
    sh:name "Title"@en, "Tittel"@nb ;
    sh:description "Display name, one value in each of English (en), Bokmål (nb) and Nynorsk (nn)."@en ;
    sh:datatype rdf:langString ;
    sh:languageIn ( "en" "nb" "nn" ) ;
    sh:uniqueLang true ;
    sh:minCount 3 ;
    sh:maxCount 3 ;
    dash:editor dash:TextFieldWithLangEditor ;
    dash:singleLine true ;
    rdm:languages ( "en" "nb" "nn" ) ;
    sh:group bnd:_shapeGroup_general ;
    sh:order 1 .

bnd:_shape_descriptionEnNbNn a sh:PropertyShape ;
    sh:path dcterms:description ;
    sh:name "Description"@en, "Beskrivelse"@nb ;
    sh:description "One value in each of English (en), Bokmål (nb) and Nynorsk (nn)."@en ;
    sh:datatype rdf:langString ;
    sh:languageIn ( "en" "nb" "nn" ) ;
    sh:uniqueLang true ;
    sh:minCount 3 ;
    sh:maxCount 3 ;
    dash:editor dash:TextAreaWithLangEditor ;
    dash:singleLine false ;
    rdm:languages ( "en" "nb" "nn" ) ;
    sh:group bnd:_shapeGroup_general ;
    sh:order 2 .

bnd:_shape_sectionTitle a sh:PropertyShape ;
    sh:path dcterms:title ;
    sh:name "Title"@en, "Tittel"@nb ;
    sh:description "Display label: English required, plus Bokmål (nb) and Nynorsk (nn). One value per language."@en ;
    sh:datatype rdf:langString ;
    sh:languageIn ( "en" "nb" "nn" "no" ) ;
    sh:uniqueLang true ;
    sh:qualifiedValueShape [ sh:languageIn ( "en" ) ] ;
    sh:qualifiedMinCount 1 ;
    sh:minCount 1 ;
    dash:editor dash:TextFieldWithLangEditor ;
    dash:singleLine true ;
    rdm:languages ( "en" "nb" "nn" ) ;
    sh:group bnd:_shapeGroup_general ;
    sh:order 1 .

bnd:_shape_preferNbOverNo a sh:NodeShape ;
    sh:targetClass bno:KeyFigureSection ;
    sh:severity sh:Warning ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Title tagged @no should be tagged @nb (Bokmål) or @nn (Nynorsk): {?value}."@en ;
        sh:prefixes <https://data.banenor.no/data/_shapes_metadata> ;
        sh:select """
            SELECT $this ?value
            WHERE {
                $this dcterms:title ?value .
                FILTER (lang(?value) = "no")
            }
        """ ] .

bnd:_shape_position a sh:PropertyShape ;
    sh:path schema:position ;
    sh:name "Position"@en, "Posisjon"@nb ;
    sh:description "Display order (1-based)."@en ;
    sh:datatype xsd:integer ;
    sh:minInclusive 1 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    dash:editor dash:TextFieldEditor ;
    sh:group bnd:_shapeGroup_display ;
    sh:order 1 .

bnd:_shape_keyFigure_section a sh:PropertyShape ;
    sh:path dcterms:isPartOf ;
    sh:name "Section"@en, "Seksjon"@nb ;
    sh:description "Section that groups this figure on the portal."@en ;
    sh:class bno:KeyFigureSection ;
    sh:nodeKind sh:IRI ;
    sh:maxCount 1 ;
    dash:editor dash:InstancesSelectEditor ;
    dash:viewer dash:LabelViewer ;
    sh:group bnd:_shapeGroup_display ;
    sh:order 2 .

bnd:_shape_usesManagedQuery a sh:PropertyShape ;
    sh:path bno:usesManagedQuery ;
    sh:name "Managed query"@en, "Lagret spørring"@nb ;
    sh:description "The yasgui managed query whose latest version produces the values. Maintain the query itself in yasgui."@en ;
    sh:class yasgui:ManagedQuery ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    dash:editor dash:InstancesSelectEditor ;
    dash:viewer dash:LabelViewer ;
    sh:group bnd:_shapeGroup_query ;
    sh:order 1 .

bnd:_shape_distributions a sh:PropertyShape ;
    sh:path dcat:distribution ;
    sh:name "Distributions"@en, "Distribusjoner"@nb ;
    sh:description "Written by the dataset-generation DAGs; not edited by hand."@en ;
    sh:class dcat:Distribution ;
    sh:node bnd:_shape_Distribution ;
    dash:readOnly true ;
    dash:viewer dash:DetailsViewer ;
    rdm:collapsed true ;
    rdm:pageSize 5 ;
    sh:group bnd:_shapeGroup_distributions ;
    sh:order 1 .

# The pipeline only picks up a managed query that has at least one version.
# Severity is a property of a shape, so warnings live in their own node shapes.
bnd:_shape_managedQueryHasVersion a sh:NodeShape ;
    sh:targetClass dcat:Dataset, bno:KeyFigure, bno:KeyFigureTable ;
    sh:severity sh:Warning ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The managed query {?value} has no yasgui:ManagedQueryVersion with spin:text, so the pipeline will skip it."@en ;
        sh:prefixes <https://data.banenor.no/data/_shapes_metadata> ;
        sh:select """
        SELECT $this ?value
        WHERE {
            $this bno:usesManagedQuery ?value .
            FILTER NOT EXISTS {
                ?version dcterms:isVersionOf ?value ;
                         spin:text ?text .
            }
        }
    """ ] .

# ---------------------------------------------------------------------------
# dcat:Dataset (CSV export)
# ---------------------------------------------------------------------------

bnd:_shape_Dataset a sh:NodeShape ;
    sh:targetClass dcat:Dataset ;
    rdfs:label "Dataset"@en, "Datasett"@nb ;
    rdfs:comment "A tabular view of the knowledge graph, exported to CSV by datasets_csv_exports."@en ;
    rdm:order 1 ;
    dash:uriStart "https://data.banenor.no/data/_dataset_" ;
    rdm:localNamePattern "^[a-z][a-z0-9]*(_[a-z0-9]+)*$" ;
    rdm:localNameDescription "lower_snake_case slug, e.g. platform_edges"@en ;
    sh:property
        bnd:_shape_titleEnNbNn ,
        bnd:_shape_descriptionEnNbNn ,
        bnd:_shape_Dataset_modified ,
        bnd:_shape_usesManagedQuery ,
        bnd:_shape_distributions .

bnd:_shape_Dataset_modified a sh:PropertyShape ;
    sh:path dcterms:modified ;
    sh:name "Modified"@en, "Endret"@nb ;
    sh:description "Date the dataset definition was last updated."@en ;
    sh:datatype xsd:date ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    dash:editor dash:DatePickerEditor ;
    rdm:defaultValue rdm:today ;
    rdm:updateOnSave true ;
    sh:group bnd:_shapeGroup_general ;
    sh:order 3 .

# ---------------------------------------------------------------------------
# bno:KeyFigureSection
# ---------------------------------------------------------------------------

bnd:_shape_KeyFigureSection a sh:NodeShape ;
    sh:targetClass bno:KeyFigureSection ;
    rdfs:label "Key figure section"@en, "Nøkkeltallseksjon"@nb ;
    rdfs:comment "A labelled panel that groups key figures on the portal."@en ;
    rdm:order 4 ;
    dash:uriStart "https://data.banenor.no/data/_keyFiguresSection_" ;
    rdm:localNamePattern "^[a-z][A-Za-z0-9]*$" ;
    rdm:localNameDescription "camelCase name, e.g. infrastructure"@en ;
    sh:property
        bnd:_shape_sectionTitle ,
        bnd:_shape_position .

# ---------------------------------------------------------------------------
# bno:KeyFigure (scalar)
# ---------------------------------------------------------------------------

bnd:_shape_KeyFigure a sh:NodeShape ;
    sh:targetClass bno:KeyFigure ;
    rdfs:label "Key figure"@en, "Nøkkeltall"@nb ;
    rdfs:comment "A scalar statistic. Its managed query returns one row with a ?value binding."@en ;
    rdm:order 2 ;
    dash:uriStart "https://data.banenor.no/data/_keyFigure_" ;
    rdm:localNamePattern "^[a-z][A-Za-z0-9]*$" ;
    rdm:localNameDescription "camelCase name, e.g. trackLength"@en ;
    sh:property
        bnd:_shape_titleEnNbNn ,
        bnd:_shape_descriptionEnNbNn ,
        bnd:_shape_usesManagedQuery ,
        bnd:_shape_position ,
        bnd:_shape_keyFigure_section ,
        bnd:_shape_KeyFigure_unitCode ,
        bnd:_shape_distributions .

bnd:_shape_KeyFigure_unitCode a sh:PropertyShape ;
    sh:path schema:unitCode ;
    sh:name "Unit"@en, "Enhet"@nb ;
    sh:description "UN/CEFACT common code shown next to the value, e.g. KMT for kilometre."@en ;
    sh:datatype xsd:string ;
    sh:pattern "^[A-Z0-9]{2,3}$" ;
    sh:maxCount 1 ;
    dash:editor dash:TextFieldEditor ;
    dash:singleLine true ;
    sh:group bnd:_shapeGroup_display ;
    sh:order 3 .

# ---------------------------------------------------------------------------
# bno:KeyFigureTable (tabular)
# ---------------------------------------------------------------------------
#
# Columns hang off csvw:tableSchema, which is the path datasets_refresh_key_figures
# reads (csvw:tableSchema/csvw:column). Note that the create-key-figure skill shows
# csvw:column directly on the figure; data authored that way is not picked up by
# the DAG and is reported by bnd:_shape_KeyFigureTable_directColumn below.

bnd:_shape_KeyFigureTable a sh:NodeShape ;
    sh:targetClass bno:KeyFigureTable ;
    rdfs:label "Key figure table"@en, "Nøkkeltallstabell"@nb ;
    rdfs:comment "A tabular statistic. Each csvw:Column names a projected variable of the managed query."@en ;
    rdm:order 3 ;
    dash:uriStart "https://data.banenor.no/data/_keyFigureTable_" ;
    rdm:localNamePattern "^[a-z][A-Za-z0-9]*$" ;
    rdm:localNameDescription "camelCase name, e.g. switchesByType"@en ;
    sh:property
        bnd:_shape_titleEnNbNn ,
        bnd:_shape_descriptionEnNbNn ,
        bnd:_shape_usesManagedQuery ,
        bnd:_shape_KeyFigureTable_tableSchema ,
        bnd:_shape_position ,
        bnd:_shape_keyFigure_section ,
        bnd:_shape_distributions .

bnd:_shape_KeyFigureTable_tableSchema a sh:PropertyShape ;
    sh:path csvw:tableSchema ;
    sh:name "Columns"@en, "Kolonner"@nb ;
    sh:description "Ordered column definitions of the result table."@en ;
    sh:class csvw:TableSchema ;
    sh:node bnd:_shape_TableSchema ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    dash:editor dash:DetailsEditor ;
    dash:viewer dash:DetailsViewer ;
    sh:group bnd:_shapeGroup_query ;
    sh:order 2 .

bnd:_shape_KeyFigureTable_directColumn a sh:NodeShape ;
    sh:targetClass bno:KeyFigureTable ;
    sh:severity sh:Warning ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "csvw:column is set directly on the figure; the pipeline reads columns from csvw:tableSchema/csvw:column."@en ;
        sh:prefixes <https://data.banenor.no/data/_shapes_metadata> ;
        sh:select """
            SELECT $this ?value
            WHERE { $this csvw:column ?value . }
        """ ] .

bnd:_shape_TableSchema a sh:NodeShape ;
    rdfs:label "Table schema"@en, "Tabellskjema"@nb ;
    dash:uriStart "https://data.banenor.no/data/_keyFigureTable_schema_" ;
    sh:property bnd:_shape_TableSchema_column ;
    sh:sparql bnd:_shape_TableSchema_uniqueColumns .

bnd:_shape_TableSchema_column a sh:PropertyShape ;
    sh:path csvw:column ;
    sh:name "Column"@en, "Kolonne"@nb ;
    sh:class csvw:Column ;
    sh:node bnd:_shape_Column ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:minCount 1 ;
    dash:editor dash:DetailsEditor ;
    dash:viewer dash:DetailsViewer ;
    rdm:orderBy schema:position ;
    sh:order 1 .

# One SPARQL constraint per shape: some engines (shacl-engine) evaluate only one
# sh:sparql per shape correctly.
bnd:_shape_TableSchema_uniqueColumns a sh:SPARQLConstraint ;
    sh:message "Column {?kind} {?value} is used more than once."@en ;
    sh:prefixes <https://data.banenor.no/data/_shapes_metadata> ;
    sh:select """
        SELECT ?kind ?value
        WHERE {
            {
                $this csvw:column ?column .
                ?column schema:position ?value .
                BIND ("position" AS ?kind)
            }
            UNION
            {
                $this csvw:column ?column .
                ?column csvw:name ?value .
                BIND ("name" AS ?kind)
            }
        }
        GROUP BY ?kind ?value
        HAVING (COUNT(?column) > 1)
    """ .

bnd:_shape_Column a sh:NodeShape ;
    sh:targetClass csvw:Column ;
    rdfs:label "Column"@en, "Kolonne"@nb ;
    dash:uriStart "https://data.banenor.no/data/_keyFigureTable_col_" ;
    rdm:localNameProperty csvw:name ;
    rdm:hideFromMenu true ;
    sh:property
        bnd:_shape_Column_name ,
        bnd:_shape_Column_position .

bnd:_shape_Column_name a sh:PropertyShape ;
    sh:path csvw:name ;
    sh:name "Variable name"@en, "Variabelnavn"@nb ;
    sh:description "Must match a projected variable of the managed query, without the leading ?."@en ;
    sh:datatype xsd:string ;
    sh:pattern "^[A-Za-z_][A-Za-z0-9_]*$" ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    dash:editor dash:TextFieldEditor ;
    dash:singleLine true ;
    sh:order 1 .

bnd:_shape_Column_position a sh:PropertyShape ;
    sh:path schema:position ;
    sh:name "Position"@en, "Posisjon"@nb ;
    sh:description "1-based column order in the CSV output."@en ;
    sh:datatype xsd:integer ;
    sh:minInclusive 1 ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    dash:editor dash:TextFieldEditor ;
    sh:order 2 .

# ---------------------------------------------------------------------------
# dcat:Distribution (read-only, written by the pipeline)
# ---------------------------------------------------------------------------

bnd:_shape_Distribution a sh:NodeShape ;
    rdfs:label "Distribution"@en, "Distribusjon"@nb ;
    dash:readOnly true ;
    rdm:orderBy dcterms:created ;
    rdm:orderDescending true ;
    sh:property
        [ sh:path dcterms:created ;   sh:name "Created"@en, "Opprettet"@nb ;
          sh:datatype xsd:dateTime ; sh:maxCount 1 ; dash:readOnly true ; sh:order 1 ] ,
        [ sh:path schema:value ;      sh:name "Value"@en, "Verdi"@nb ;
          sh:maxCount 1 ; dash:readOnly true ; sh:order 2 ] ,
        [ sh:path dcterms:format ;    sh:name "Format"@en, "Format"@nb ;
          sh:maxCount 1 ; dash:readOnly true ; sh:order 3 ] ,
        [ sh:path schema:name ;       sh:name "File name"@en, "Filnavn"@nb ;
          sh:maxCount 1 ; dash:readOnly true ; sh:order 4 ] ,
        [ sh:path schema:contentUrl ; sh:name "Content URL"@en, "Innholds-URL"@nb ;
          sh:maxCount 1 ; dash:readOnly true ; sh:order 5 ] ,
        [ sh:path dcat:byteSize ;     sh:name "Size (bytes)"@en, "Størrelse (byte)"@nb ;
          sh:maxCount 1 ; dash:readOnly true ; sh:order 6 ] .

# ---------------------------------------------------------------------------
# RDF Data Manager annotation vocabulary used above
# ---------------------------------------------------------------------------
# rdm:order               integer  menu order of a top-level node shape
# rdm:hideFromMenu        boolean  do not list this target class in the menu
# rdm:localNamePattern    string   regex for the part of a new IRI after dash:uriStart
# rdm:localNameDescription string  help text for that local name
# rdm:localNameProperty   IRI      property whose value completes the IRI of a new nested node
# rdm:defaultValue        node     value pre-filled on create (rdm:today = current date)
# rdm:updateOnSave        boolean  set the value to today whenever the resource is saved
# rdm:orderBy             IRI      property used to sort multiple values / nested nodes
# rdm:orderDescending     boolean  sort descending instead of ascending
# rdm:collapsed           boolean  start the field collapsed (default: collapsed when it has more than 5 values)
# rdm:pageSize            integer  values shown before "Show more" (default 10)
# rdm:languages           list     language tags the form offers for a text field, in order
