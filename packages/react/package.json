{
  "name": "@rdf-data-manager/react",
  "version": "0.1.0",
  "description": "React form components and the widget registry of RDF Data Manager: forms generated from SHACL/DASH shapes",
  "keywords": [
    "rdf",
    "sparql",
    "shacl",
    "dash",
    "react",
    "forms"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Matdata-eu/rdf-data-manager.git"
  },
  "homepage": "https://github.com/Matdata-eu/rdf-data-manager#readme",
  "bugs": {
    "url": "https://github.com/Matdata-eu/rdf-data-manager/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./form.css": "./dist/form.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/form.css dist/",
    "test": "vitest run"
  },
  "dependencies": {
    "@rdf-data-manager/core": "0.1.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
