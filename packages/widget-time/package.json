    "widget"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Matdata-eu/rdf-data-manager.git"
  },
  "homepage": "https://github.com/Matdata-eu/rdf-data-manager#readme",
  "bugs": {
    "url": "https://github.com/Matdata-eu/rdf-data-manager/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@rdf-data-manager/core": "0.1.0",
